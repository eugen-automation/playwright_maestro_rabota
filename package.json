{
  "name": "playwright_maestro_rabota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "tsx scripts/check-docs.ts",
    "test:foundation": "tsx --test shared/config/load-env.test.ts shared/api/clients/read-only-api-client.test.ts shared/api/clients/public-jobs-contracts.test.ts web/fixtures/pom/read-only-policy.test.ts shared/api/clients/test-account-auth-client.test.ts shared/utils/mobile-runner.test.ts",
    "test:web:ui": "playwright test --config web/playwright.config.ts --project ui-chromium",
    "test:web:api": "playwright test --config web/playwright.config.ts --project api",
    "test:web:e2e": "playwright test --config web/playwright.config.ts --project e2e-chromium",
    "test:web:smoke": "playwright test --config web/playwright.config.ts --project api --project e2e-chromium --grep @smoke",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:docs && npm run test:foundation",
    "test:web:auth": "playwright test --config web/playwright.config.ts --project api-auth",
    "test:mobile:android": "tsx scripts/run-mobile.ts --platform android",
    "check:mobile": "tsx scripts/run-mobile.ts --check",
    "test:web:e2e:compat": "playwright test --config web/playwright.config.ts --project e2e-chromium --project e2e-chrome --project e2e-edge --project e2e-firefox"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
