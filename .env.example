# Copy to .env and replace placeholders. Never commit .env.
WEB_BASE_URL=<verified-web-origin>
TEST_LOCALE=<supported-locale>
# Defaults to false; set true deliberately for public read-only web execution.
ALLOW_PRODUCTION_READ_ONLY=<true-or-false>
# Optional: normally injected by CI. Allowed values: true, false, or empty.
CI=<true-false-or-empty>
