# Copy to .env and replace placeholders. Never commit .env.
WEB_BASE_URL=<verified-web-origin>
# Optional until running the observed public API; must match WEB_BASE_URL.
# API_BASE_URL=<verified-same-origin-api-origin>
TEST_LOCALE=<supported-locale>
# Defaults to false; set true deliberately for public read-only web execution.
ALLOW_PRODUCTION_READ_ONLY=<true-or-false>
# Separate opt-in for the GET-only public API client; defaults to false.
# ALLOW_PUBLIC_READ_ONLY_API=<true-or-false>
# Dedicated account credentials; never put real values in this template.
# AUTH_BASE_URL=<verified-same-origin-auth-origin>
# TEST_ACCOUNT_USERNAME=<dedicated-test-account-login>
# TEST_ACCOUNT_PASSWORD=<dedicated-test-account-password>
# Separate sign-in/sign-out-only capability; defaults to false.
# ALLOW_TEST_ACCOUNT_AUTH=<true-or-false>
# Android: verify installed package/build and a dedicated device before setting.
# ANDROID_APP_ID=<verified-installed-android-package>
# ANDROID_DEVICE_ID=<reserved-connected-android-device>
# ANDROID_APP_VERSION=<verified-installed-version-name>
# Independent opt-in for reviewed public read-only Android flows; defaults false.
# ALLOW_ANDROID_READ_ONLY=<true-or-false>
# Optional: normally injected by CI. Allowed values: true, false, or empty.
CI=<true-false-or-empty>
